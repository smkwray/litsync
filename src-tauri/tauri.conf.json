{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LitSync",
  "version": "0.1.0",
  "identifier": "com.litsync.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LitSync",
        "width": 1024,
        "height": 768,
        "minWidth": 640,
        "minHeight": 480,
        "theme": "Dark",
        "titleBarStyle": "Transparent",
        "backgroundColor": "#0d0f14",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
